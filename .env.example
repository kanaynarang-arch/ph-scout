# Product Hunt developer token (server-side only)
PH_API_TOKEN=
# Google AI Studio key (server-side only)
GEMINI_API_KEY=
# Gemini Flash model id, for example gemini-3.8-flash
GEMINI_MODEL=
# Neon Postgres pooled connection string (added by the Vercel Neon integration)
DATABASE_URL=
# Random string that protects /api/refresh
CRON_SECRET=
# Optional: send a copy of the list to Kavya's own Telegram and email when she clicks Generate.
# Nothing is sent unless NOTIFICATIONS_ENABLED=true and the channel's variables exist.
NOTIFICATIONS_ENABLED=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
NOTIFY_EMAIL=
# Optional: isolates test runs in the database (leave unset in production; the default is v1)
# CACHE_NS=
# Optional backup route to Gemini Flash through OpenRouter (used only if the direct Google call fails)
OPENROUTER_API_KEY=
